<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_arca_tax_config_list" model="ir.ui.view">
        <field name="name">l10n_ar.arca.tax.config.list</field>
        <field name="model">l10n_ar.arca.tax.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="tax_ganancias_id"/>
                <field name="tax_iibb_id"/>
                <field name="tax_perc_iva_21_id"/>
                <field name="tax_perc_iva_105_id"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ar_arca_tax_config_form" model="ir.ui.view">
        <field name="name">l10n_ar.arca.tax.config.form</field>
        <field name="model">l10n_ar.arca.tax.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Impuestos ARCA">
                <sheet>
                    <div class="text-muted mb-3">
                        Opcional. Si se dejan vacíos, la importación automática del "Libro de Compras"
                        busca estos impuestos por nombre. Si esa búsqueda llegara a fallar (por
                        diferencias de formato en el nombre), fijar acá el impuesto exacto la evita
                        por completo.
                    </div>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Impuestos de Percepción del Libro de Compras">
                        <field name="tax_ganancias_id" options="{'no_create': True}"/>
                        <field name="tax_iibb_id" options="{'no_create': True}"/>
                        <field name="tax_perc_iva_21_id" options="{'no_create': True}"/>
                        <field name="tax_perc_iva_105_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ar_arca_tax_config" model="ir.actions.act_window">
        <field name="name">Configuración de Impuestos ARCA</field>
        <field name="res_model">l10n_ar.arca.tax.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
